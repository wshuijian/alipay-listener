<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="136dp" android:background="@drawable/bg_payment_card" android:gravity="center_vertical" android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="10dp" android:paddingTop="10dp" android:paddingBottom="10dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/tv_payment_latest_badge" android:layout_width="wrap_content" android:layout_height="19dp" android:background="@drawable/bg_payment_latest_badge" android:gravity="center" android:paddingStart="7dp" android:paddingEnd="7dp" android:text="最新" android:textColor="#8ABEFF" android:textSize="10sp" android:visibility="gone"/>
        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
        <View android:layout_width="8dp" android:layout_height="8dp" android:background="#00D6A0"/>
    </LinearLayout>
    <TextView android:id="@+id/tv_payment_amount" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="¥0.00" android:textColor="#F5F7FA" android:textSize="24sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
    <TextView android:id="@+id/tv_payment_channel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="支付宝" android:textColor="#AAB5C1" android:textSize="13sp" android:maxLines="1" android:ellipsize="end"/>
    <TextView android:id="@+id/tv_payment_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="12:34:56" android:textColor="#9AA8B6" android:textSize="12sp"/>
</LinearLayout>
