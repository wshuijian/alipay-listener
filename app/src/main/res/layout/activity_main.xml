<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1419"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- 顶部时间 -->
    <TextView
        android:id="@+id/tv_current_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="2026-09-29 17:00:00"
        android:textColor="#8896A8"
        android:textSize="13sp"
        android:gravity="center"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="最近收款记录"
        android:textColor="#F0F4F8"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="20dp"/>

    <!-- 最新一笔收款：绿色发光高亮 -->
    <LinearLayout
        android:id="@+id/layout_latest"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:alignItems="center"
        android:background="#1A2028"
        android:padding="16dp"
        android:layout_marginBottom="12dp"
        android:elevation="4dp">

        <TextView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_wechat_circle"
            android:text="微"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:gravity="center"
            android:layout_marginEnd="12dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="微信支付"
            android:textColor="#F0F4F8"
            android:textSize="18sp"/>

        <TextView
            android:id="@+id/tv_latest_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¥110.00"
            android:textColor="#F0F4F8"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginEnd="16dp"/>

        <TextView
            android:id="@+id/tv_latest_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="17:00:00"
            android:textColor="#8896A8"
            android:textSize="13sp"/>
    </LinearLayout>

    <!-- 最近收款列表 -->
    <ListView
        android:id="@+id/lv_payments"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#2D3744"
        android:dividerHeight="1dp"/>

    <!-- 今日统计卡片 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1A2028"
        android:padding="16dp"
        android:orientation="horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="今日收款总额"
                android:textColor="#8896A8"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/tv_today_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¥0.00"
                android:textColor="#FFB020"
                android:textSize="32sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="right">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="今日笔数"
                android:textColor="#8896A8"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/tv_today_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#F0F4F8"
                android:textSize="32sp"
                android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>

    <!-- 底部功能按钮：弱化 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/btn_pair"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="44dp"
            android:text="配对连接"
            android:textSize="13sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#07C160"
            android:layout_marginEnd="6dp"/>

        <Button
            android:id="@+id/btn_permission"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="44dp"
            android:text="开通知权限"
            android:textSize="13sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1677FF"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"/>

        <Button
            android:id="@+id/btn_log"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="44dp"
            android:text="日志"
            android:textSize="13sp"
            android:textColor="#8896A8"
            android:backgroundTint="#222A35"
            android:layout_marginStart="6dp"/>
    </LinearLayout>

</LinearLayout>
