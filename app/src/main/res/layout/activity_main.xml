<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#07111D">
    <LinearLayout android:layout_width="match_parent" android:layout_height="62dp" android:gravity="center_vertical" android:paddingStart="18dp" android:paddingEnd="8dp" android:background="#081725">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/tv_shop_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="长风照相馆" android:textColor="#F5F8FC" android:textSize="18sp" android:textStyle="bold"/>
            <TextView android:id="@+id/tv_clock" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2026-10-10  00:00:00" android:textColor="#91A8BD" android:textSize="11sp"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/top_actions" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical">
            <TextView android:id="@+id/tv_status_top" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="4dp" android:text="未连接" android:textColor="#F2B84B" android:textSize="11sp"/>
            <ImageButton android:id="@+id/btn_refresh" android:layout_width="34dp" android:layout_height="38dp" android:background="@android:color/transparent" android:contentDescription="刷新连接状态" android:src="@android:drawable/ic_popup_sync" android:tint="#BCD3EA"/>
            <ImageButton android:id="@+id/btn_fullscreen" android:layout_width="34dp" android:layout_height="38dp" android:background="@android:color/transparent" android:contentDescription="全屏" android:src="@android:drawable/ic_menu_view" android:tint="#BCD3EA"/>
            <ImageButton android:id="@+id/btn_orientation" android:layout_width="34dp" android:layout_height="38dp" android:background="@android:color/transparent" android:contentDescription="横竖屏切换" android:src="@android:drawable/ic_menu_rotate" android:tint="#BCD3EA"/>
        </LinearLayout>
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:id="@+id/panel_home" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="16dp" android:paddingTop="8dp" android:paddingBottom="6dp" android:text="最近收款" android:textColor="#DCE8F3" android:textSize="15sp" android:textStyle="bold"/>
            <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
                <ListView android:id="@+id/lv_payments" android:layout_width="match_parent" android:layout_height="match_parent" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="6dp" android:paddingBottom="8dp" android:divider="@android:color/transparent" android:dividerHeight="8dp" android:clipToPadding="false"/>
                <TextView android:id="@+id/tv_home_empty" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="等待收款…&#10;新订单会自动显示在这里" android:textColor="#60758A" android:textSize="15sp"/>
            </FrameLayout>
        </LinearLayout>
        <ScrollView android:id="@+id/panel_data" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="18dp" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="数据中心" android:textColor="#F5F8FC" android:textSize="24sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="今天的经营概览与历史流水查询" android:textColor="#8DA4B9" android:textSize="13sp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="120dp" android:layout_marginTop="18dp" android:padding="18dp" android:orientation="vertical" android:gravity="center_vertical" android:background="@drawable/bg_payment_card_latest">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="今日收款总额" android:textColor="#9AB1C8" android:textSize="13sp"/>
                    <TextView android:id="@+id/tv_data_total" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="¥0.00" android:textColor="#F7FBFF" android:textSize="30sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/tv_data_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 笔交易" android:textColor="#00D6A0" android:textSize="13sp"/>
                </LinearLayout>
                <Button android:id="@+id/btn_open_history" android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginTop="18dp" android:gravity="center_vertical" android:paddingStart="18dp" android:text="▤    历史订单与日期查询     ›" android:textAlignment="viewStart" android:textColor="#E6F1FC" android:backgroundTint="#10283C"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="首页始终显示今天的实时收款；其他日期请在历史订单里查询。" android:textColor="#7890A6" android:textSize="12sp"/>
            </LinearLayout>
        </ScrollView>
        <LinearLayout android:id="@+id/panel_history" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="10dp" android:paddingEnd="10dp" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center_vertical">
                <Button android:id="@+id/btn_history_back" android:layout_width="44dp" android:layout_height="42dp" android:text="‹" android:textSize="24sp" android:textColor="#D8E8F7" android:backgroundTint="#10283C"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:paddingStart="8dp" android:text="历史订单" android:textColor="#F5F8FC" android:textSize="20sp" android:textStyle="bold"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:background="#0E2030" android:paddingStart="4dp" android:paddingEnd="4dp">
                <Button android:id="@+id/btn_history_prev" android:layout_width="42dp" android:layout_height="40dp" android:text="‹" android:textColor="#D8E8F7" android:backgroundTint="#173149"/>
                <TextView android:id="@+id/tv_history_date" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="2026年10月10日" android:textColor="#E6F1FC" android:textSize="14sp"/>
                <Button android:id="@+id/btn_history_next" android:layout_width="42dp" android:layout_height="40dp" android:text="›" android:textColor="#D8E8F7" android:backgroundTint="#173149"/>
                <Button android:id="@+id/btn_pick_history_date" android:layout_width="86dp" android:layout_height="40dp" android:text="选择日期" android:textColor="#FFFFFF" android:backgroundTint="#087F67"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/tv_history_total" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="总金额：¥0.00" android:textColor="#F5F8FC" android:textSize="16sp" android:textStyle="bold"/>
                <TextView android:id="@+id/tv_history_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0笔" android:textColor="#00D6A0" android:textSize="13sp"/>
            </LinearLayout>
            <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
                <ListView android:id="@+id/lv_history_payments" android:layout_width="match_parent" android:layout_height="match_parent" android:paddingTop="8dp" android:divider="@android:color/transparent" android:dividerHeight="8dp" android:clipToPadding="false"/>
                <TextView android:id="@+id/tv_history_empty" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="这一天没有收款记录" android:textColor="#60758A" android:textSize="15sp"/>
            </FrameLayout>
        </LinearLayout>
        <ScrollView android:id="@+id/panel_device" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="18dp" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="设备状态" android:textColor="#F5F8FC" android:textSize="24sp" android:textStyle="bold"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:padding="18dp" android:orientation="vertical" android:background="@drawable/bg_payment_card">
                    <TextView android:id="@+id/tv_device_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="MQTT：等待连接或配对" android:textColor="#DCE8F3" android:textSize="17sp"/>
                    <TextView android:id="@+id/tv_notification_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="通知监听：检查中" android:textColor="#A9BED1" android:textSize="15sp"/>
                </LinearLayout>
                <Button android:id="@+id/btn_device_notification_access" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="16dp" android:text="检查 / 开启通知监听权限" android:textColor="#FFFFFF" android:backgroundTint="#087F67"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="如未连接，请在设置页检查配对码并启动监听服务。" android:textColor="#7890A6" android:textSize="13sp"/>
            </LinearLayout>
        </ScrollView>
        <ScrollView android:id="@+id/panel_settings" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="16dp" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="设置" android:textColor="#F5F8FC" android:textSize="24sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="横屏每行显示数量可选 4–12；屏幕较窄时自动减少实际显示数量" android:textColor="#8DA4B9" android:textSize="13sp"/>
                <Spinner android:id="@+id/sp_display_columns" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:background="#10283C" android:paddingStart="10dp" android:paddingEnd="10dp" android:spinnerMode="dropdown"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="会记住上次选择，并根据手机或平板屏幕宽度自适应卡片大小；竖屏保持单列。" android:textColor="#718AA1" android:textSize="12sp"/>
                <EditText android:id="@+id/et_pair_code" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="14dp" android:hint="输入6位配对码" android:gravity="center" android:inputType="number" android:maxLength="6" android:textColor="#F5F8FC" android:textColorHint="#667D92" android:textSize="18sp" android:background="#10283C"/>
                <Button android:id="@+id/btn_start" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="10dp" android:text="启动监听服务" android:textColor="#FFFFFF" android:backgroundTint="#00A97C"/>
                <Button android:id="@+id/btn_open_notification_access" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="8dp" android:text="开启通知监听权限" android:textColor="#DCE8F3" android:backgroundTint="#173149"/>
                <CheckBox android:id="@+id/cb_tts_switch" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:buttonTint="#00D6A0" android:text="开启本机语音播报" android:textColor="#DCE8F3" android:checked="true"/>
                <TextView android:id="@+id/tv_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textColor="#7F96AA" android:textSize="12sp"/>
                <Button android:id="@+id/btn_copy_log" android:layout_width="match_parent" android:layout_height="38dp" android:layout_marginTop="12dp" android:text="高级诊断：复制全部日志" android:textSize="13sp" android:backgroundTint="#10283C" android:textColor="#00D6A0"/>
                <ScrollView android:layout_width="match_parent" android:layout_height="120dp" android:layout_marginTop="8dp" android:background="#081725"><TextView android:id="@+id/tv_log" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp" android:textColor="#718AA1" android:textSize="10sp" android:fontFamily="monospace"/></ScrollView>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
    <LinearLayout android:id="@+id/bottom_bar" android:layout_width="match_parent" android:layout_height="58dp" android:background="#081725" android:orientation="horizontal">
        <TextView android:id="@+id/tab_home" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="⌂&#10;首页" android:textColor="#00D6A0" android:textSize="13sp"/>
        <TextView android:id="@+id/tab_data" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="▤&#10;数据" android:textColor="#8B9CAF" android:textSize="13sp"/>
        <TextView android:id="@+id/tab_device" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="▣&#10;设备" android:textColor="#8B9CAF" android:textSize="13sp"/>
        <TextView android:id="@+id/tab_settings" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="⚙&#10;设置" android:textColor="#8B9CAF" android:textSize="13sp"/>
    </LinearLayout>
</LinearLayout>
