<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:background="#F8F9FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 标题 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="支付宝收款监听"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            android:textColor="#1A73E8"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="全网通版 · WiFi/流量都能用"
            android:textSize="13sp"
            android:gravity="center"
            android:textColor="#666666"
            android:layout_marginBottom="24dp" />

        <!-- 状态显示卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="#FFFFFF"
            android:elevation="2dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/tv_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="状态加载中..."
                android:textSize="14sp"
                android:lineSpacingExtra="6dp"
                android:textColor="#333333" />
        </LinearLayout>

        <!-- 配对码输入 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="请输入电脑端显示的6位配对码"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/et_pair_code"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="例如: 867686"
            android:inputType="number"
            android:maxLength="6"
            android:textSize="24sp"
            android:gravity="center"
            android:letterSpacing="0.3"
            android:background="#FFFFFF"
            android:elevation="1dp"
            android:layout_marginBottom="20dp" />

        <!-- 开始按钮 -->
        <Button
            android:id="@+id/btn_start"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="开始监听"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1A73E8"
            android:layout_marginBottom="10dp" />

        <!-- 停止按钮 -->
        <Button
            android:id="@+id/btn_stop"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="停止监听"
            android:textSize="15sp"
            android:textColor="#666666"
            android:backgroundTint="#E0E0E0"
            android:layout_marginBottom="16dp" />

        <!-- 开启通知权限 -->
        <Button
            android:id="@+id/btn_open_notification_access"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="开启通知监听权限（必须）"
            android:textSize="14sp"
            android:textColor="#1A73E8"
            android:backgroundTint="#E8F0FE"
            android:layout_marginBottom="10dp" />

        <!-- 测试通知按钮 -->
        <Button
            android:id="@+id/btn_test_notify"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="发送测试通知（验证监听是否正常）"
            android:textSize="13sp"
            android:textColor="#FF6D00"
            android:backgroundTint="#FFF3E0"
            android:layout_marginBottom="24dp" />

        <!-- 使用说明 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="使用说明"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. 电脑端打开智慧收款软件，查看配对码\n2. 在上方输入6位配对码\n3. 点击\"开启通知监听权限\"，允许本应用监听通知\n4. 点击\"开始监听\"\n5. 保持支付宝APP在后台运行\n6. 收到支付宝收款时，电脑端自动播报\n\n支持WiFi和手机流量，全网通用"
            android:textSize="13sp"
            android:lineSpacingExtra="5dp"
            android:textColor="#666666"
            android:layout_marginBottom="20dp" />

        <!-- 日志 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="运行日志"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/tv_log"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:text=""
            android:textSize="11sp"
            android:padding="10dp"
            android:background="#F0F0F0"
            android:fontFamily="monospace"
            android:textColor="#444444" />

    </LinearLayout>
</ScrollView>
