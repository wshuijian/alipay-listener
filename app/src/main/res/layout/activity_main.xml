<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#0B1015">
    <LinearLayout android:layout_width="match_parent" android:layout_height="58dp" android:gravity="center_vertical" android:paddingStart="18dp" android:paddingEnd="10dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/tv_shop_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="长风照相馆" android:textColor="#F5F7FA" android:textSize="18sp" android:textStyle="bold"/>
            <TextView android:id="@+id/tv_clock" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="---- -- --  --:--:--" android:textColor="#7F8B99" android:textSize="11sp"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/top_actions" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical">
            <TextView android:id="@+id/tv_status_top" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="10dp" android:text="未连接" android:textColor="#F2B84B" android:textSize="12sp"/>
            <ImageButton android:id="@+id/btn_fullscreen" android:layout_width="40dp" android:layout_height="40dp" android:background="@android:color/transparent" android:contentDescription="全屏" android:src="@android:drawable/ic_menu_view"/>
            <ImageButton android:id="@+id/btn_orientation" android:layout_width="40dp" android:layout_height="40dp" android:background="@android:color/transparent" android:contentDescription="横竖屏切换" android:src="@android:drawable/ic_menu_rotate"/>
        </LinearLayout>
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:id="@+id/panel_data" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
            <!-- 日期切换栏 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:padding="8dp" android:background="#151C24">
                <TextView android:id="@+id/btn_prev_day" android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:text="‹" android:textColor="#F5F7FA" android:textSize="24sp" android:clickable="true"/>
                <TextView android:id="@+id/tv_selected_date" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="今天" android:textColor="#F5F7FA" android:textSize="16sp"/>
                <TextView android:id="@+id/btn_next_day" android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:text="›" android:textColor="#F5F7FA" android:textSize="24sp" android:clickable="true"/>
            </LinearLayout>
            <ListView android:id="@+id/lv_payments" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="8dp" android:divider="@android:color/transparent" android:dividerHeight="8dp" android:clipToPadding="false"/>
        </LinearLayout>
        <ScrollView android:id="@+id/panel_device" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" android:padding="20dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="设备状态" android:textColor="#F5F7FA" android:textSize="24sp" android:textStyle="bold"/>
                <TextView android:id="@+id/tv_device_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:textColor="#A9B4C0" android:textSize="16sp"/>
                <TextView android:id="@+id/tv_notification_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:textColor="#A9B4C0" android:textSize="16sp"/>
            </LinearLayout>
        </ScrollView>
        <ScrollView android:id="@+id/panel_settings" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" android:padding="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="设置" android:textColor="#F5F7FA" android:textSize="24sp" android:textStyle="bold"/>
                <EditText android:id="@+id/et_pair_code" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="18dp" android:hint="输入6位配对码" android:gravity="center" android:inputType="number" android:maxLength="6" android:textColor="#F5F7FA" android:textColorHint="#667382" android:textSize="18sp" android:background="#202832"/>
                <Button android:id="@+id/btn_start" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="12dp" android:text="启动监听服务"/>
                <Button android:id="@+id/btn_open_notification_access" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="8dp" android:text="开启通知监听权限"/>
                <CheckBox android:id="@+id/cb_tts_switch" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="语音播报（本软件语音提示）" android:textColor="#F5F7FA" android:checked="true"/>
                <TextView android:id="@+id/tv_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:textColor="#7F8B99" android:textSize="12sp"/>
                <Button android:id="@+id/btn_copy_log" android:layout_width="match_parent" android:layout_height="38dp" android:layout_marginTop="10dp" android:text="复制全部日志" android:textSize="14dp" android:background="#202832" android:textColor="#07C160"/>
                <ScrollView android:layout_width="match_parent" android:layout_height="120dp" android:layout_marginTop="8dp" android:background="#0F1419"><TextView android:id="@+id/tv_log" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp" android:textColor="#65717F" android:textSize="10sp" android:fontFamily="monospace"/></ScrollView>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
    <LinearLayout android:id="@+id/bottom_bar" android:layout_width="match_parent" android:layout_height="58dp" android:background="#151C24" android:orientation="horizontal">
        <TextView android:id="@+id/tab_data" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="数据" android:textColor="#F5F7FA" android:textSize="14sp"/>
        <TextView android:id="@+id/tab_device" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="设备" android:textColor="#8B97A5" android:textSize="14sp"/>
        <TextView android:id="@+id/tab_settings" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="设置" android:textColor="#8B97A5" android:textSize="14sp"/>
    </LinearLayout>
</LinearLayout>