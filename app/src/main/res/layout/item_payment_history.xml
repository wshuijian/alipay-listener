<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:background="@drawable/bg_payment_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="14dp">
    <TextView
        android:id="@+id/tv_payment_channel_icon"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:gravity="center"
        android:text="微"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"/>
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/tv_payment_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¥0.00"
            android:textColor="#F5F7FA"
            android:textSize="22sp"
            android:textStyle="bold"/>
        <TextView
            android:id="@+id/tv_payment_channel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="微信支付"
            android:textColor="#AAB5C1"
            android:textSize="12sp"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical">
        <TextView
            android:id="@+id/tv_payment_latest_badge"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:background="@drawable/bg_payment_latest_badge"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="最新"
            android:textColor="#8ABEFF"
            android:textSize="10sp"
            android:visibility="gone"/>
        <TextView
            android:id="@+id/tv_payment_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="12:34:56"
            android:textColor="#9AA8B6"
            android:textSize="12sp"/>
    </LinearLayout>
</LinearLayout>
